<!DOCTYPE html>
<html lang="{{ lang }}">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ title }} | Prime Paint & Home Services</title>
<meta name="description" content="{{ summary }}">
<meta name="robots" content="index, follow">
<meta name="theme-color" content="#0f2547">
<link rel="canonical" href="https://primeprowork.com/{{ permalink }}">
<link rel="alternate" hreflang="en" href="https://primeprowork.com/blog/{{ slug }}/">
<link rel="alternate" hreflang="es" href="https://primeprowork.com/es/blog/{{ slug }}/">
<link rel="alternate" hreflang="x-default" href="https://primeprowork.com/blog/{{ slug }}/">

<meta property="og:type" content="article">
<meta property="og:site_name" content="Prime Paint & Home Services">
<meta property="og:title" content="{{ title }}">
<meta property="og:description" content="{{ summary }}">
<meta property="og:url" content="https://primeprowork.com/{{ permalink }}">

<link rel="icon" href="/images/favicon.svg">
<link rel="stylesheet" href="/css/style.css">
</head>
<body>

<div class="topbar">
  <div class="wrap topbar__inner">
    <span class="topbar__areas">Serving Westfield, Agawam, Springfield & Western MA</span>
    <span>Free estimates — <a href="sms:+14134860396">413-486-0396</a></span>
  </div>
</div>

<header class="site-header">
  <div class="wrap">
    <div class="site-header__inner">
      <a class="brand" href="/">
        <span class="brand__mark" aria-hidden="true">PP</span>
        <span>
          <span class="brand__name">Prime Paint</span>
          <span class="brand__tag">& Home Services</span>
        </span>
      </a>
      <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="site-nav">
        <span class="nav-toggle__bars" aria-hidden="true"><span></span></span>
        Menu
      </button>
    </div>
    <nav class="site-nav" id="site-nav" aria-label="Main">
      <ul>
        <li><a href="/">Home</a></li>
        <li><a href="/services.html">Services</a></li>
        <li><a href="/gallery.html">Gallery</a></li>
        <li><a href="/blog/">Blog</a></li>
        <li><a href="/contact.html">Contact</a></li>
        <li class="lang-switch">
          {% if lang == "en" %}
            <a class="is-active" href="/blog/{{ slug }}/" lang="en" hreflang="en">EN</a>
            <span aria-hidden="true">|</span>
            <a href="/es/blog/{{ slug }}/" lang="es" hreflang="es">ES</a>
          {% else %}
            <a href="/blog/{{ slug }}/" lang="en" hreflang="en">EN</a>
            <span aria-hidden="true">|</span>
            <a class="is-active" href="/es/blog/{{ slug }}/" lang="es" hreflang="es">ES</a>
          {% endif %}
        </li>
        <li><a class="btn btn--gold" href="sms:+14134860396">Text 413-486-0396</a></li>
      </ul>
    </nav>
  </div>
</header>

<main id="main">
  <article class="blog-post">
    <div class="wrap wrap--narrow">

      {% if image %}
      <img class="blog-post__hero" src="/{{ image }}" alt="{{ title }}" width="1200" height="630" loading="eager" decoding="async">
      {% endif %}

      <header class="blog-post__header">
        <p class="eyebrow">{{ category }} · {{ date }}</p>
        <h1>{{ title }}</h1>
        <p class="lead">{{ summary }}</p>
      </header>

      <div class="blog-post__body">
        {{ content | safe }}
      </div>

      <div class="blog-post__cta">
        <h2>Ready for a free estimate?</h2>
        <p>Text or message us — we usually respond the same day.</p>
        <div class="btn-row">
          <a class="btn btn--gold" href="/contact.html#estimate-form">Get a Free Estimate</a>
          <a class="btn btn--outline" href="https://m.me/PrimePaintHome" target="_blank" rel="noopener">Message on Facebook</a>
        </div>
      </div>

    </div>
  </article>
</main>

<footer class="site-footer">
  <div class="wrap">
    <div class="footer__grid">
      <div class="footer__brand">
        <h4>Prime Paint & Home Services</h4>
        <p>Painting and home services for homeowners across Westfield, Agawam, Springfield and Western Massachusetts. Free estimates, clean work, honest pricing.</p>
      </div>
      <div>
        <h4>Pages</h4>
        <ul>
          <li><a href="/">Home</a></li>
          <li><a href="/services.html">Services</a></li>
          <li><a href="/gallery.html">Gallery</a></li>
          <li><a href="/blog/">Blog</a></li>
          <li><a href="/contact.html">Contact</a></li>
        </ul>
      </div>
      <div>
        <h4>Contact</h4>
        <ul>
          <li><a href="sms:+14134860396">413-486-0396</a></li>
          <li><a href="mailto:prosnipercr7@gmail.com">prosnipercr7@gmail.com</a></li>
          <li><a href="https://www.facebook.com/PrimePaintHome" target="_blank" rel="noopener">Facebook</a></li>
          <li><a href="https://m.me/PrimePaintHome" target="_blank" rel="noopener">Messenger</a></li>
        </ul>
      </div>
    </div>
    <div class="footer__bottom">
      <p>&copy; 2025 Prime Paint & Home Services. Serving Western Massachusetts.</p>
    </div>
  </div>
</footer>

<div class="call-bar">
  <a class="btn btn--gold" href="sms:+14134860396">Text Now</a>
  <a class="btn btn--navy" href="https://m.me/PrimePaintHome" target="_blank" rel="noopener">Message</a>
</div>

<script src="/js/main.js" defer></script>
</body>
</html>